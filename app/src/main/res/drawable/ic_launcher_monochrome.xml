    <!-- Hollow OUTLINE chevron for Android 13+ themed icons (user call 2026-07-23: the filled
         mono read as a blob in the themed circle; thinned to Lawnicons/stock-Pixel weight the
         same day; shrunk 30% on 2026-08-08, user call - the glyph filled too much of the themed
         circle). Round joins - a miter would spike far past the acute tip. The group stays
         centred on (54,54): translate = 54 - centre(256,238)*scale. Stroke 23 in the 512 path
         space keeps the RENDERED weight at ~2.9dp through the smaller scale (16/0.7) - shrinking
         the stroke with the glyph would have dropped it below the tuned Lawnicons weight. -->
    <group
        android:scaleX="0.126"
        android:scaleY="0.126"
        android:translateX="21.744"
        android:translateY="24.012">
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="23"
            android:strokeLineJoin="round"
            android:pathData="M256,100 L146,376 L256,318 L366,376 Z" />
    </group>
</vector>
