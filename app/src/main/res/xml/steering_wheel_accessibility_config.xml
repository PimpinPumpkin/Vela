<?xml version="1.0" encoding="utf-8"?>
<!-- The steering-wheel key filter (SPEC 10.9). flagRequestFilterKeyEvents is what lets the service
     see hardware keys; canRetrieveWindowContent is false because it reads nothing on screen. The
     window-state-changed event type is the minimum the platform needs to deliver keys. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="50"
    android:description="@string/steering_wheel_a11y_description" />
